{
  "$schema": "https://schema.tauri.app/v2/tauri.schema.json",
  "productName": "WOS",
  "version": "2.0.1",
  "identifier": "com.wira.wos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WOS — Wira Operating System",
        "width": 1600,
        "height": 950,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.frankfurter.app https://api.open-meteo.com https://quote-garden.onrender.com https://api.coinpaprika.com https://query1.finance.yahoo.com https://indonesian-public-holidays.vercel.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCQTc2OTlCNEREQkUwQTQKUldTazROdE5tMm1uZTRrZFMwL2I3aTNNRHRsZEdyUWFjVmlaaEUrcWtoYmpHc01ISmlRSVI1MDgK",
      "endpoints": [
        "https://github.com/sepatusendal/wos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
