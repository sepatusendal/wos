{
  "$schema": "https://raw.githubusercontent.com/nicholasio/nicholasio/VERSION/tauri-config-schema.json",
  "identifier": "default",
  "description": "Capability untuk WOS desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
